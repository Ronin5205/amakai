{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "types": ["jest", "node"],
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true,
    "isolatedModules": false,
    "paths": {
      "@/*": ["./*"],
      "@amakai/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
