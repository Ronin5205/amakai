# Copy to .env.local and fill in values from the Supabase dashboard.
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Encrypts user secrets at rest (falls back to SUPABASE_SECRET_KEY if unset)
SECRETS_ENCRYPTION_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_LANDING_URL=http://localhost:3000
# Base URL for inbound webhook links in Operate (must match how external callers reach the portal)
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

# Stripe billing (single gateway — lib/stripe/gateway.ts only)
# Card data never touches Amakai (Checkout + Customer Portal over TLS).
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret for POST /api/stripe/webhook (required in every env; never skip verify)
# Local: stripe listen --forward-to localhost:3001/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Optional — enable Pro Checkout when ready (recurring Price ID; clients cannot override)
STRIPE_PRO_PRICE_ID=

# Optional: protect POST /api/internal/process-queue (schedule tick + queue worker)
# Call every minute from your cron provider with Authorization: Bearer <secret>
CRON_SECRET=

# Gmail OAuth (optional — enables Connect Gmail in Resources → Secrets)
# Each user connects their own mailbox; these are app credentials, not a shared account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match Authorized redirect URI in Google Cloud Console (Web client):
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/auth/integrations/gmail
# Optional: Pub/Sub topic for Gmail inbound (projects/{project}/topics/{topic})
GMAIL_PUBSUB_TOPIC=

# Microsoft / Outlook OAuth (optional — same per-user connect model as Gmail)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3001/auth/integrations/outlook
