{
  "name": "amakai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:landing": "npm run dev --workspace=@amakai/landing",
    "dev:portal": "npm run dev --workspace=@amakai/portal",
    "build": "npm run build --workspaces --if-present",
    "build:landing": "npm run build --workspace=@amakai/landing",
    "build:portal": "npm run build --workspace=@amakai/portal",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=@amakai/portal",
    "test:watch": "npm run test:watch --workspace=@amakai/portal"
  }
}
