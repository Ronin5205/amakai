# Copy apps/portal/.env.example to apps/portal/.env.local for local portal development.
# See that file for Supabase and cross-app URL variables.

# Public URL for this app (set per deploy target)
NEXT_PUBLIC_SITE_URL=

# Cross-app links (set on landing and portal respectively)
NEXT_PUBLIC_LANDING_URL=
NEXT_PUBLIC_PORTAL_URL=

# Optional server-only key for admin/service tasks (never expose in the browser)
SUPABASE_SECRET_KEY=

# Auth redirect URLs to add in Supabase Dashboard → Authentication → URL Configuration:
#   Site URL (dev):     http://localhost:3001
#   Site URL (prod):    https://your-portal-domain.com
#   Redirect URLs:      http://localhost:3001/auth/callback
#                       https://your-portal-domain.com/auth/callback
#
# OAuth providers to enable in Supabase Dashboard → Authentication → Providers:
#   - Google  (https://supabase.com/docs/guides/auth/social-login/auth-google)
#   - GitHub  (https://supabase.com/docs/guides/auth/social-login/auth-github)
